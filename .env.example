# Simulation
SIM_SEED=42
# llm : l'abeille 0 décide via Ollama (repli à règles signalé si indisponible) ; regles : 10 abeilles à règles
SIM_MODE=llm
SIM_DT=0.1
# secondes simulées par seconde réelle
SIM_SPEED=4
SIM_MAX_TIME=600

# Indicateur de consensus (n'est jamais communiqué aux abeilles)
CONSENSUS_MIN_BEES=8
CONSENSUS_HOLD_S=10

# Kafka (Docker Compose, port publié sur l'hôte)
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=bee.events.v1
KAFKA_GROUP=bee-metrics

# Ollama (sur l'hôte)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/openjev/openjev-GGUF:Q4_K_M
OLLAMA_TIMEOUT_S=30
OLLAMA_NUM_CTX=4096

# WebSocket Python -> Godot
WS_HOST=127.0.0.1
WS_PORT=8765

# SQLite (relatif à la racine du projet)
SQLITE_PATH=data/essaim.sqlite3
